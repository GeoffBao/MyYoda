        "apiToken": "ATLASSIAN_API_TOKEN"
      },
      "credentialFields": [
        {
          "key": "siteUrl",
          "label": "站点地址（如 https://xxx.atlassian.net）",
          "placeholder": "https://..."
        },
        {
          "key": "email",
          "label": "账号邮箱",
          "placeholder": "you@company.com"
        },
        {
          "key": "apiToken",
          "label": "API Token",
          "secret": true,
          "placeholder": "ATATT..."
        }
      ]
    },
    {
      "id": "sentry",
      "source": "local",
