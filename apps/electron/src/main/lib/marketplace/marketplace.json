{
  "items": [
    {
      "id": "slack",
      "source": "local",
      "type": "connector",
      "name": "Slack",
      "description": "查询频道、读取消息、搜索与发消息，让 Agent 接入团队协作空间。",
      "iconKey": "slack",
      "vendor": "official",
      "author": "Slack",
      "homepage": "https://github.com/slackhq/slack-mcp-server",
      "category": "协作办公",
      "installKind": "npx-mcp",
      "npxPackage": "@slackhq/slack-mcp-server",
      "envMap": {
        "token": "SLACK_BOT_TOKEN",
        "teamId": "SLACK_TEAM_ID"
      },
      "credentialFields": [
        {
          "key": "token",
          "label": "Bot Token",
          "secret": true,
          "placeholder": "xoxb-..."
        },
        {
          "key": "teamId",
          "label": "Team ID（可选）",
          "placeholder": "T..."
        }
      ]
    },
    {
      "id": "linear",
      "source": "local",
      "type": "connector",
      "name": "Linear",
      "description": "读写 Issue、项目与团队，把 Agent 接入产品研发流程。",
      "iconKey": "linear",
      "vendor": "official",
      "author": "Linear",
      "homepage": "https://github.com/linearapp/linear-mcp-server",
      "category": "研发与交付",
      "installKind": "npx-mcp",
      "npxPackage": "linear-mcp-server",
      "envMap": {
        "apiKey": "LINEAR_API_KEY"
      },
      "credentialFields": [
        {
          "key": "apiKey",
          "label": "Personal API Key",
          "secret": true,
          "placeholder": "lin_api_..."
        }
      ]
    },
    {
      "id": "jira-confluence",
      "source": "local",
      "type": "connector",
